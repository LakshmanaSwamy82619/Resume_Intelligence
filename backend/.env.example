# Copy to .env and fill in real values. Never commit a real .env file.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local/dev/test default (zero external services):
DATABASE_URL=sqlite+aiosqlite:///./resume_intel.db
# Production (Postgres + pgvector): Docker Compose builds DATABASE_URL from
# POSTGRES_USER/PASSWORD/DB below. Keep the password URL-safe (for example,
# generate it with secrets.token_urlsafe(32)).
DATABASE_ECHO=false
VECTOR_DIMENSION=384
POSTGRES_USER=resume_intel
POSTGRES_PASSWORD=
POSTGRES_DB=resume_intel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Auth ---
# Generate your own secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# IMPORTANT: rotate any secret that has ever been shared in chat, a ticket, or a screenshot.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_PER_MINUTE=3

# --- File upload ---
MAX_UPLOAD_MB=15
MAX_BULK_FILES=100
MAX_BULK_UPLOAD_MB=250
UPLOAD_DIR=./data/uploads

# --- LLM provider (ArshnivLabs KeyGateway, OpenAI-compatible chat endpoint) ---
LLM_PROVIDER=keygateway
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://keygateway1.arshnivlabs.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_FALLBACK_PROVIDER=none

# --- Embedding provider ---
# "local" runs sentence-transformers on-box (falls back to an offline
# hashing vectorizer automatically if the model can't be downloaded).
# Only set this to "keygateway" after confirming an /v1/embeddings route
# actually exists on your gateway -- see README "KeyGateway capability notes".
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_FALLBACK_PROVIDER=local_hashing

# --- Reranker provider ---
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
RETRIEVAL_CANDIDATE_POOL_SIZE=100
RETRIEVAL_RERANK_TOP_K=20
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.15
HYBRID_LEXICAL_WEIGHT=0.4
HYBRID_SEMANTIC_WEIGHT=0.6

# --- Email ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@resume-intel.local
SMTP_USE_TLS=true

# --- Bootstrap (creates the first Admin user on startup if set) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassword123!
